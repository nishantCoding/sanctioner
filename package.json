{
  "name": "acl.lite",
  "version": "0.1.0",
  "description": "O(1) route-level ACL with framework-agnostic core. Access as primitive, roles as sugar, with pluggable adapters.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "hono": ">=3.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "express": "^4.18.2",
    "fastify": "^5.12.8",
    "hono": "^4.13.16",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "acl",
    "access-control",
    "authorization",
    "roles",
    "permissions",
    "middleware",
    "express",
    "fastify",
    "hono",
    "rbac"
  ],
  "author": "nishantCoding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishantCoding/aclite.git"
  },
  "homepage": "https://github.com/nishantCoding/aclite#readme",
  "bugs": {
    "url": "https://github.com/nishantCoding/aclite/issues"
  }
}
